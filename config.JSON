  "preprocesamiento": {
    "percentil_inferior_recorte": 0.01,
    "percentil_superior_recorte": 0.99,
    "frecuencia_minima_categoria": 0.01
  },
  "entrenamiento": {
    "cv_folds": 5,
    "metrica_principal": "average_precision",
    "pesos_seleccion": {
      "rendimiento": 0.6,
      "consistencia": 0.2,
      "escalabilidad": 0.2
    }
  },
  "salidas": {
    "modelo": "mejor_modelo.joblib",
