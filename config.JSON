{
  "datos": {
    "archivo": "Base_de_datos.csv",
    "objetivo_original": "Pago_atiempo",
    "objetivo_modelo": "impago"
  },
  "particion": {
    "test_size": 0.2,
    "random_state": 42
  },
  "limpieza": {
    "edad_maxima_valida": 100,
    "puntaje_datacredito_minimo_valido": 100,
    "categorias_tendencia": ["Decreciente", "Estable", "Creciente"],
    "variables_eliminadas": ["saldo_mora_codeudor", "puntaje", "fecha_prestamo"]
